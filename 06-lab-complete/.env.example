# ============================================================
# Environment Configuration Template (DO NOT put real secrets here)
# Usage: cp .env.example .env
# ============================================================
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Authentication (set strong random key in production)
AGENT_API_KEY=change-me-in-production

# Redis connection for stateless rate limiting & cost guard
REDIS_URL=redis://localhost:6379/0

# Rate limit & LLM cost protection
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
